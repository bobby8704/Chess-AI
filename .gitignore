# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual Environment
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# PyTorch models (large binary files)
models/*.pt
models/*.pth
data/training/*.pt

# Training datasets (regeneratable)
data/training/*.npz
data/datasets/

# Benchmark results (machine-specific timings, regenerate with bench/verify.py)
bench/results/

# Exported inference model. NOTE: this is the artifact the web server actually serves.
# Leaving it ignored means a clone-based deploy has no weights at all and silently
# falls back to a uniform (random) policy. Consider committing it — it is ~18MB, well
# inside GitHub's limits — or fetching it in the deploy step.
models/*.onnx
models/*.onnx.data

# Stockfish binary (too large for git)
stockfish/
stockfish.exe

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Database files
*.db

# Training logs
data/training/*.txt

# OS
.DS_Store
Thumbs.db
