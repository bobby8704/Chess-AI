# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual Environment
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# PyTorch models (large binary files)
models/*.pt
models/*.pth
data/training/*.pt

# Training datasets (regeneratable)
data/training/*.npz
data/datasets/

# Benchmark results are regenerable and contain machine-specific timings.
bench/results/

# bench/suites/ is deliberately TRACKED. The strength comparison is only valid if both
# arms run on the identical frozen position set, so the suite must be shared and stable
# across commits and machines — rebuilding it silently invalidates every prior number.

# NOTE: models/dual_model_mcts_fp32.onnx is deliberately TRACKED, not ignored. It is
# the artifact the web server actually serves, and keeping it in the repo is what makes
# a clone-based deploy work — see bench/test_deploy.py. Torch checkpoints (*.pt) stay
# ignored: they are training artifacts, and the .onnx is regenerated from them by
# export_onnx.py.
models/*.onnx.data

# Stockfish binary (too large for git)
stockfish/
stockfish.exe

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Database files
*.db

# Training logs
data/training/*.txt

# OS
.DS_Store
Thumbs.db
